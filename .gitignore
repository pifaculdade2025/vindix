!FonteJS/scripts/modelos/*.fbk
backups/
BaseDados/

# Dependências: instaladas em cada servidor com "npm ci" (o bcrypt tem binário por sistema)
node_modules/

# Editor e sistema
.vscode/
*.log
Thumbs.db
.DS_Store
